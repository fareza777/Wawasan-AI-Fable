# URL situs (untuk sitemap, RSS, OG)
# FIX 2026-06-12: Production URL. Saat ini Vercel default subdomain (no custom domain).
# Override ini di Vercel dashboard → Settings → Environment Variables kalau beli domain nanti.
NEXT_PUBLIC_SITE_URL=https://www.wawasanai.com

# Analytics — Vercel Web Analytics hanya aktif saat build di Vercel.
# Di Cloudflare: opsional Cloudflare Web Analytics (build variable)
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Newsletter via Resend (opsional — tanpa ini mode demo lokal)
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Daily Trendshift snapshots: src/data/dailySnapshots/*.json (git, bukan Vercel Blob).
# Vercel Cron /api/cron/daily-snapshot dinonaktifkan — snapshot via Hermes cron + git commit.

# Runtime secrets Worker Cloudflare (lihat MIGRATION-CLOUDFLARE.md)
# Admin dashboard (/admin) — sementara sampai Supabase Auth aktif
ADMIN_EMAILS=fajar.mreza@gmail.com
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
