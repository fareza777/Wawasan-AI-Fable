# Cloudflare Workers Static Assets headers.
# Metadata image routes are exported without a file extension — set the type explicitly.
/opengraph-image
  Content-Type: image/png
/*/opengraph-image
  Content-Type: image/png
/icon
  Content-Type: image/png
/apple-icon
  Content-Type: image/png

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
